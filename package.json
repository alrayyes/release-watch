{
	"name": "release-watch",
	"version": "0.0.0",
	"private": true,
	"description": "Alpine image carrying the tools a scheduled release-watch job needs",
	"bugs": {
		"url": "https://github.com/alrayyes/release-watch/issues"
	},
	"repository": "https://github.com/alrayyes/release-watch",
	"license": "GPL-3.0-or-later",
	"author": "Ryan Kes <511318+alrayyes@users.noreply.github.com>",
	"scripts": {
		"audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm",
		"check:biome-schema": "./scripts/check-biome-schema.sh",
		"format": "prettier --write",
		"format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
		"lint": "biome check",
		"lint:fix": "biome check --write --no-errors-on-unmatched",
		"lint:md": "markdownlint-cli2",
		"lint:md:files": "markdownlint-cli2 --no-globs",
		"lint:mechanics": "./scripts/lint-mechanics.sh",
		"lint:pkg": "sort-package-json --check",
		"lint:pkg:fix": "sort-package-json",
		"lint:prose": "./scripts/lint-prose.sh",
		"prepare": "lefthook install"
	},
	"overrides": {
		"fast-uri": "3.1.8",
		"smol-toml": "1.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"lefthook": "2.1.16",
		"markdownlint-cli2": "0.23.3",
		"prettier": "3.9.9",
		"sort-package-json": "4.0.0"
	}
}
